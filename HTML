<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 실시간 양방향 번역기 (Standalone)</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { font-family: 'Inter', 'Noto Sans KR', sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; overflow: hidden; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }

        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.5; }
            80% { transform: scale(1.5); opacity: 0; }
            100% { transform: scale(1.5); opacity: 0; }
        }
        .mic-active-ring::before {
            content: ''; position: absolute; left: 0; top: 0; right: 0; bottom: 0;
            border-radius: 50%; background-color: #ef4444;
            animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; z-index: -1;
        }

        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .animation-fade-in { animation: fadeIn 0.3s ease-out forwards; }

        .markdown-content h2, .markdown-content h3 { font-size: 1.125rem; font-weight: 700; color: #f8fafc; margin-top: 1rem; margin-bottom: 0.5rem; border-bottom: 1px solid #334155; padding-bottom: 0.25rem; }
        .markdown-content p { margin-bottom: 0.75rem; line-height: 1.6; color: #cbd5e1; }
        .markdown-content ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 1rem; color: #cbd5e1; }
        .markdown-content li { margin-bottom: 0.25rem; }
    </style>
</head>
<body class="flex flex-col h-screen w-full">

    <header class="flex-none bg-slate-800/80 backdrop-blur-md border-b border-slate-700 p-4 sticky top-0 z-10 flex items-center justify-between shadow-sm">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/20">
                <i class="fa-solid fa-language text-white text-lg"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-300">AI 실시간 양방향 번역기</h1>
                <p class="text-xs text-slate-400 font-medium tracking-wide">SK 바이오텍 CAPEX 팀 (Standalone)</p>
            </div>
        </div>
        
        <div class="flex items-center gap-3">
            <div id="apiStatusBadge" class="flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 px-3 py-1.5 rounded-full shadow-inner">
                <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                <span class="text-xs text-emerald-300 font-semibold">마이크 권한 및 API 준비됨</span>
            </div>
        </div>
    </header>

    <div class="flex-1 flex flex-col md:flex-row overflow-hidden">
        <div class="flex-1 relative flex flex-col bg-slate-100 p-4 sm:p-6 overflow-hidden z-0">
            
            <div class="flex justify-between items-center mb-4 z-10 flex-wrap gap-2">
                <h2 class="text-slate-700 font-bold text-lg flex items-center"><i class="fa-solid fa-file-lines mr-2 text-blue-500"></i>회의 실시간 노트</h2>
                
                <div class="flex items-center gap-3">
                    <button id="copyBtn" class="bg-white border border-slate-300 hover:bg-slate-50 text-slate-600 px-3 py-1.5 rounded-lg text-sm font-medium shadow-sm transition-colors flex items-center gap-2">
                        <i class="fa-regular fa-copy"></i> 전체 복사
                    </button>
                </div>
            </div>

            <div id="noteWrapper" class="flex-1 bg-white rounded-2xl shadow-lg border border-slate-200 overflow-y-auto relative z-10 pb-28">
                <div id="transcriptArea" class="p-6 sm:p-8 font-sans space-y-6 selection:bg-blue-100">
                    <div id="welcomeMessage" class="flex flex-col items-center justify-center text-center text-slate-400 mt-28 space-y-4">
                        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center border border-slate-200 shadow-sm">
                            <i class="fa-solid fa-microphone-lines text-3xl text-blue-500"></i>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-700 mb-2">실시간 음성 인식 준비 완료</h2>
                            <p class="text-sm sm:text-base leading-relaxed text-slate-500">하단의 마이크 버튼을 누르면 브라우저 마이크가 즉시 활성화됩니다.<br>말씀하시는 내용이 실시간으로 인식되어 DeepL 번역으로 전달됩니다.</p>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="absolute bottom-6 left-0 w-full flex justify-center z-30 pointer-events-none px-4">
                <div class="w-full max-w-3xl flex items-center gap-2 sm:gap-3 bg-slate-800/95 backdrop-blur-lg border border-slate-700/50 p-3 pl-4 pr-3 rounded-2xl shadow-2xl pointer-events-auto">
                    
                    <select id="micLangSelect" class="bg-slate-700 text-slate-200 text-xs font-semibold px-2.5 py-2 rounded-xl border border-slate-600 focus:outline-none cursor-pointer shrink-0">
                        <option value="ko-KR">🇰🇷 한국어</option>
                        <option value="en-US">🇺🇸 영어</option>
                    </select>

                    <input type="text" id="manualInput" placeholder="직접 타이핑하거나 마이크를 사용하세요..." class="flex-1 bg-transparent border-none focus:outline-none text-slate-100 placeholder-slate-400 text-sm sm:text-base font-medium px-2" autocomplete="off">
                    
                    <button id="sendBtn" class="w-10 h-10 rounded-xl bg-blue-600 hover:bg-blue-500 flex items-center justify-center transition-colors shadow-md text-white shrink-0">
                        <i class="fa-solid fa-paper-plane text-sm"></i>
                    </button>

                    <div class="w-px h-8 bg-slate-600 mx-1 shrink-0"></div>

                    <div class="flex flex-col items-center justify-center shrink-0 w-12 hidden sm:flex mr-1">
                        <span id="statusIndicator" class="text-[10px] font-bold text-slate-400 tracking-wider uppercase mb-0.5">대기 중</span>
                        <span id="duration" class="text-xs font-mono text-slate-300">00:00</span>
                    </div>

                    <button id="micBtn" class="relative w-11 h-11 rounded-xl bg-slate-700 hover:bg-slate-600 flex items-center justify-center transition-all duration-300 shadow-md border border-slate-600 group shrink-0">
                        <i id="micIcon" class="fa-solid fa-microphone text-white text-base"></i>
                    </button>
                </div>
            </footer>
        </div>

        <aside class="w-full md:w-[380px] lg:w-[420px] border-t md:border-t-0 md:border-l border-slate-700 bg-slate-900 flex flex-col z-10 shrink-0">
            <div class="p-5 border-b border-slate-800 bg-slate-800/40">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="text-white font-bold flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-amber-400"></i> API 설정 및 요약
                    </h3>
                </div>
                
                <div class="space-y-3">
                    <div>
                        <label class="text-xs font-semibold text-slate-300 block mb-1">DeepL API Key (번역용)</label>
                        <input type="password" id="deeplKeyInput" value="faf7762c-a8de-4a48-bbdc-3870c1a41cca:fx" class="block w-full px-3 py-2 border border-slate-700 rounded-lg bg-slate-950 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-300 block mb-1">Gemini API Key (요약용)</label>
                        <input type="password" id="geminiKeyInput" value="AIzaSyCBYruen1aKi1sBp1hgzcInVz2rMVcUbys" class="block w-full px-3 py-2 border border-slate-700 rounded-lg bg-slate-950 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-blue-500">
                    </div>

                    <button id="summarizeBtn" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold py-2.5 px-4 rounded-lg transition-colors flex items-center justify-center gap-2 shadow-md mt-2">
                        <i class="fa-solid fa-bolt text-amber-300"></i> AI 회의록 요약 실행
                    </button>
                </div>
            </div>

            <div class="flex-1 overflow-y-auto p-5 bg-slate-900 relative markdown-content">
                <div id="summaryPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-slate-500 p-6 text-center">
                    <i class="fa-solid fa-clipboard-list text-3xl mb-3 opacity-30"></i>
                    <p class="text-sm">요약 버튼을 누르면 핵심 논의사항과<br>Action Item이 정리됩니다.</p>
                </div>

                <div id="summaryLoading" class="hidden absolute inset-0 flex flex-col items-center justify-center text-amber-400 p-6 text-center z-10">
                    <i class="fa-solid fa-circle-notch fa-spin text-3xl mb-4"></i>
                    <p class="text-sm font-medium text-slate-300">Gemini AI가 문맥을 분석 중입니다...</p>
                </div>

                <div id="summaryResult" class="hidden text-sm text-slate-300 space-y-3 leading-relaxed"></div>
            </div>

            <div class="border-t border-slate-800/80 bg-slate-950/50 p-4 shrink-0 flex flex-col items-center justify-center gap-1 z-20">
                <p class="text-xs text-slate-400">SK 바이오텍 CAPEX 팀 | 하동명 책임 (hadomy@sk.com)</p>
            </div>
        </aside>
    </div>

    <script>
        const micBtn = document.getElementById('micBtn'), micIcon = document.getElementById('micIcon');
        const statusIndicator = document.getElementById('statusIndicator'), durationEl = document.getElementById('duration');
        const transcriptArea = document.getElementById('transcriptArea'), noteWrapper = document.getElementById('noteWrapper');
        const welcomeMessage = document.getElementById('welcomeMessage');
        const manualInput = document.getElementById('manualInput'), sendBtn = document.getElementById('sendBtn');
        const micLangSelect = document.getElementById('micLangSelect');
        const copyBtn = document.getElementById('copyBtn');
        const deeplKeyInput = document.getElementById('deeplKeyInput'), geminiKeyInput = document.getElementById('geminiKeyInput');

        let isRecording = false;
        let recognition = null;
        let timerInterval = null, seconds = 0;

        // Speech Recognition Setup (Bypasses iframe restrictions when run standalone)
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRecognition) {
            recognition = new SpeechRecognition();
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onresult = (event) => {
                let interim = '';
                let final = '';
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) {
                        final += event.results[i][0].transcript;
                    } else {
                        interim += event.results[i][0].transcript;
                    }
                }

                if (final) {
                    processAndTranslate(final.trim());
                }
            };

            recognition.onerror = (event) => {
                console.error("Speech recognition error:", event.error);
                stopRecordingState();
            };

            recognition.onend = () => {
                if (isRecording) {
                    try { recognition.start(); } catch(e) {}
                }
            };
        } else {
            alert("이 브라우저는 음성 인식을 지원하지 않습니다. Chrome 또는 Edge를 사용해주세요.");
        }

        micBtn.addEventListener('click', () => {
            if (!recognition) {
                alert("음성 인식을 지원하지 않는 환경입니다.");
                return;
            }

            if (!isRecording) {
                recognition.lang = micLangSelect.value;
                try {
                    recognition.start();
                    isRecording = true;
                    if (welcomeMessage) welcomeMessage.style.display = 'none';

                    micBtn.classList.replace('bg-slate-700', 'bg-red-500');
                    micBtn.classList.add('mic-active-ring', 'border-red-400');
                    micIcon.className = 'fa-solid fa-stop text-white text-base';
                    statusIndicator.textContent = '녹음중';
                    statusIndicator.className = 'text-[10px] font-bold text-red-400 tracking-wider uppercase mb-0.5';

                    seconds = 0;
                    durationEl.textContent = '00:00';
                    timerInterval = setInterval(() => {
                        seconds++;
                        const m = Math.floor(seconds / 60).toString().padStart(2, '0');
                        const s = (seconds % 60).toString().padStart(2, '0');
                        durationEl.textContent = `${m}:${s}`;
                    }, 1000);
                } catch(e) {
                    alert("마이크 시작 오류: " + e.message);
                }
            } else {
                stopRecordingState();
            }
        });

        function stopRecordingState() {
            isRecording = false;
            if (recognition) {
                try { recognition.stop(); } catch(e) {}
            }
            clearInterval(timerInterval);

            micBtn.classList.replace('bg-red-500', 'bg-slate-700');
            micBtn.classList.remove('mic-active-ring', 'border-red-400');
            micIcon.className = 'fa-solid fa-microphone text-white text-base';
            statusIndicator.textContent = '대기 중';
            statusIndicator.className = 'text-[10px] font-bold text-slate-400 tracking-wider uppercase mb-0.5';
            durationEl.textContent = '00:00';
        }

        async function processAndTranslate(sourceText) {
            if (!sourceText) return;
            if (welcomeMessage) welcomeMessage.style.display = 'none';

            const hasKorean = /[ㄱ-ㅎㅏ-ㅣ가-힣]/.test(sourceText);
            const targetLang = hasKorean ? 'EN' : 'KO';

            const entry = document.createElement('div');
            entry.className = 'bg-white border border-slate-200 rounded-2xl p-5 mb-5 shadow-sm animation-fade-in space-y-3';
            entry.innerHTML = `
                <div class="flex items-center justify-between">
                    <span class="text-xs font-mono font-semibold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-md"><i class="fa-solid fa-comment mr-1.5"></i> ${hasKorean ? 'KR (한국어 원문)' : 'EN (영어 원문)'}</span>
                    <span class="text-xs text-slate-400 font-mono">${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', second:'2-digit'})}</span>
                </div>
                <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed">${sourceText}</p>
                <div class="border-t border-slate-100 pt-3 mt-2">
                    <div class="flex items-center justify-between mb-1">
                        <span class="text-xs font-mono font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md"><i class="fa-solid fa-language mr-1.5"></i> ${hasKorean ? 'EN (DeepL 비즈니스 번역)' : 'KR (DeepL 비즈니스 번역)'}</span>
                    </div>
                    <p class="text-xl sm:text-2xl text-slate-900 font-bold leading-relaxed target-text">
                        <span class="text-slate-400 font-normal text-base animate-pulse"><i class="fa-solid fa-spinner fa-spin mr-2"></i> DeepL 번역 중...</span>
                    </p>
                </div>
            `;
            transcriptArea.appendChild(entry);
            noteWrapper.scrollTo({ top: noteWrapper.scrollHeight, behavior: 'smooth' });

            const targetEl = entry.querySelector('.target-text');
            const deeplKey = deeplKeyInput.value.trim();

            try {
                // DeepL API Request (Note: DeepL API requires proxy or direct call if CORS allows. For client-side direct fetch, DeepL Free API supports CORS for some origins or via proxy. If CORS blocks, we can use MyMemory or LibreTranslate as fallback)
                const response = await fetch("https://api-free.deepl.com/v2/translate", {
                    method: "POST",
                    headers: {
                        "Authorization": "DeepL-Auth-Key " + deeplKey,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        text: [sourceText],
                        target_lang: targetLang
                    })
                });

                if (!response.ok) {
                    throw new Error(`DeepL HTTP ${response.status}`);
                }

                const data = await response.json();
                const translation = data.translations[0].text.trim();
                targetEl.innerHTML = translation;
                noteWrapper.scrollTo({ top: noteWrapper.scrollHeight, behavior: 'smooth' });

            } catch (err) {
                // Fallback translation if DeepL CORS restricts browser-direct calls
                try {
                    const fallbackRes = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(sourceText)}&langpair=${hasKorean ? 'ko|en' : 'en|ko'}`);
                    const fallbackData = await fallbackRes.json();
                    const translation = fallbackData.responseData?.translatedText || "번역 실패";
                    targetEl.innerHTML = translation + ' <span class="text-xs text-amber-500">(Fallback)</span>';
                    noteWrapper.scrollTo({ top: noteWrapper.scrollHeight, behavior: 'smooth' });
                } catch(e) {
                    targetEl.innerHTML = `<span class="text-red-500 font-medium text-base">번역 실패: ${err.message}</span>`;
                }
            }
        }

        function submitManualText() {
            const text = manualInput.value.trim();
            if (!text) return;
            processAndTranslate(text);
            manualInput.value = '';
        }

        sendBtn.addEventListener('click', submitManualText);
        manualInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') submitManualText(); });

        copyBtn.addEventListener('click', function() {
            let fullText = "";
            document.querySelectorAll('#transcriptArea .bg-white').forEach(entry => {
                const p = entry.querySelectorAll('p');
                if (p.length >= 2) fullText += `Source: ${p[0].innerText}\nTranslation: ${p[1].innerText}\n\n`;
            });
            if (!fullText) return;
            navigator.clipboard.writeText(fullText).then(() => {
                const orig = this.innerHTML;
                this.innerHTML = '<i class="fa-solid fa-check text-green-600"></i> 복사됨';
                setTimeout(() => this.innerHTML = orig, 2000);
            });
        });

        document.getElementById('summarizeBtn').addEventListener('click', async () => {
            const apiKey = geminiKeyInput.value.trim();
            if (!apiKey) {
                alert("Gemini API Key를 입력해주세요.");
                return;
            }

            let fullText = "";
            document.querySelectorAll('#transcriptArea .bg-white').forEach(entry => {
                const targetText = entry.querySelector('.target-text')?.innerText || "";
                if (targetText && !targetText.includes('실패') && !targetText.includes('중...')) fullText += targetText + "\n";
            });

            if (!fullText) {
                alert("요약할 번역 노트 내용이 없습니다.");
                return;
            }

            document.getElementById('summaryPlaceholder').classList.add('hidden');
            document.getElementById('summaryResult').classList.add('hidden');
            document.getElementById('summaryLoading').classList.remove('hidden');

            const prompt = "다음은 회의 중에 기록된 대화 번역 텍스트입니다. 마크다운 형식으로 요약해 주세요:\n1) 핵심 논의 사항 (Key Takeaways)\n2) Action Items (담당자 및 실행 과제)\n\n" + fullText;
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error?.message || `HTTP ${response.status}`);

                const summaryText = data.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || "요약 결과가 없습니다.";
                document.getElementById('summaryLoading').classList.add('hidden');
                document.getElementById('summaryResult').classList.remove('hidden');
                document.getElementById('summaryResult').innerHTML = marked.parse(summaryText);

            } catch (err) {
                document.getElementById('summaryLoading').classList.add('hidden');
                document.getElementById('summaryResult').classList.remove('hidden');
                document.getElementById('summaryResult').innerHTML = `<p class="text-red-400 p-4 bg-red-950/30 border border-red-500/50 rounded-xl">요약 오류: ${err.message}</p>`;
            }
        });
    </script>
</body>
</html>
